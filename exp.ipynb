      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "H = np.eye(len(b)) - 2 / v.dot(v) * np.outer(v, v)\n",
    "H"
   ]
  },
