   ],
   "source": [
    "b = np.array([5, 3, 7])\n",
    "v = b + np.sign(b[0]) * np.linalg.norm(b) * np.eye(len(b))[0]\n",
    "v"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "f3627630",
   "metadata": {},
